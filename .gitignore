# Build artifacts (Cargo)
/target/
**/cargo-target/
/dist/

# Cargo
Cargo.lock
**/*.rs.bk

# IDE
.idea/
.vscode/
./mise
*.swp
*.swo
*~
**/*.db
**/cargo-target
**/venv
**/.direnv
*.wasm
*.xcodeproj

# macOS
**/*.DS_Store

# Environment
.env
.env.local

# Test artifacts
*.profraw
*.profdata
/coverage/

# Worktrees
.worktrees/

# Package build artifacts
pkg/*/payload/
pkg/*/build/
# Local munkipkg manifests (main release uses pkgbuild; build-info.toml is for local munkipkg dev only)
pkg/*/build-info.toml

# Generated output (root only, not crate src/output/ modules)
/output/
*.mobileconfig
# …but checked-in test fixtures override the global ignore
!crates/*/tests/fixtures/**/*.mobileconfig

# Project config (user-specific)
.contour/
# Schema data (downloaded at build time)
crates/mdm-schema/data/*.parquet
crates/mdm-schema/data/*.toml
crates/mscp-schema/data/*.parquet
crates/mscp-schema/data/*.json
crates/osquery-schema/data/*.parquet
crates/app-policy-schema/data/*.parquet
crates/windows-schema/data/*.parquet
# OS seed channel: data-beta/ beside data/ (downloaded at build time)
crates/mdm-schema/data-beta/
crates/mdm-schema/data-beta.staging-*/
crates/mdm-schema/data-beta.replaced-*/
# The stamp naming which dataset filled data/, and the directories a build
# swaps through when it replaces data/ (build-support/schema_data.rs).
crates/*-schema/data/.dataset-pin
crates/*-schema/data.staging-*/
crates/*-schema/data.replaced-*/
# Top-level schema archives — orphaned build-time data, never read by build.rs
# (it extracts the gitignored data/*.parquet or downloads via CONTOUR_*_SCHEMA_URL)
crates/mdm-schema.zip
crates/mscp-schema.zip
crates/osquery-schema.zip

# Local mSCP source clone (used by `contour mscp generate` / `list-baselines`)
/macos_security/

# Local preset library template (scaffold for an external repo, not part of contour)
/contour-presets/

# Cached checkout of the pinned dataset (see schema-data.toml).
/.schema-data/

# Per-developer MCP client registration (claude mcp add --scope project).
/.mcp.json

# Default output of `contour profile ddm app-control scan` — local scan results.
/app-control.toml
